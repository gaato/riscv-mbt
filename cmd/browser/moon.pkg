import {
  "gaato/riscv_mbt" @riscv,
}

supported_targets = "+wasm+wasm-gc"

options(
  link: {
    "wasm-gc": {
      "use-js-builtin-string": true,
      "exports": [
        "browser_init",
        "browser_step",
        "browser_run_tick",
        "browser_run_for",
        "browser_toggle_run",
        "browser_reset",
        "browser_send_input",
        "browser_send_input_byte",
        "browser_flush_input",
        "browser_begin_artifact",
        "browser_push_artifact_byte",
        "browser_push_artifact_words4",
        "browser_finish_artifact",
        "browser_load_linux_from_artifacts",
        "browser_artifact_loaded_mask",
        "browser_artifact_size",
        "browser_guest_kind",
        "browser_total_steps",
        "browser_decode_cache_hits",
        "browser_decode_cache_misses",
        "browser_translate_cache_hits",
        "browser_translate_cache_misses",
        "browser_console_length",
        "browser_console_code_at",
        "browser_pc",
        "browser_privilege",
        "browser_reg",
        "browser_is_running",
      ],
    },
    "wasm": {
      "exports": [
        "browser_init",
        "browser_step",
        "browser_run_tick",
        "browser_run_for",
        "browser_toggle_run",
        "browser_reset",
        "browser_send_input_byte",
        "browser_flush_input",
        "browser_begin_artifact",
        "browser_push_artifact_byte",
        "browser_push_artifact_words4",
        "browser_finish_artifact",
        "browser_load_linux_from_artifacts",
        "browser_artifact_loaded_mask",
        "browser_artifact_size",
        "browser_guest_kind",
        "browser_total_steps",
        "browser_decode_cache_hits",
        "browser_decode_cache_misses",
        "browser_translate_cache_hits",
        "browser_translate_cache_misses",
        "browser_console_length",
        "browser_console_code_at",
        "browser_pc",
        "browser_privilege",
        "browser_reg",
        "browser_is_running",
      ],
    },
  },
)
